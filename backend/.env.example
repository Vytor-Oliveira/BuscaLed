# Banco de dados
DATABASE_URL=postgresql://buscaled:buscaled_dev@localhost:5432/buscaled

# Autenticação
JWT_SECRET=troque-por-uma-chave-secreta-forte
JWT_REFRESH_SECRET=troque-por-outra-chave-secreta-forte
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET não é usado no fluxo atual (verificação de ID token),
# só seria necessário para um fluxo de authorization code no servidor.
GOOGLE_CLIENT_SECRET=

# URL base da aplicação — usada para montar o link de confirmação de e-mail
APP_BASE_URL=http://localhost:3000

# Origem do frontend — usada pelo CORS para liberar cookies de sessão, e como
# base dos links que caem no navegador: o redirecionamento do /auth/confirm e o
# link de redefinição de senha.
FRONTEND_URL=http://localhost:5173

# PuxaPlaca (ex-apiplacas.com.br) — https://api.puxaplaca.app
APIPLACAS_TOKEN=

# E-mail transacional. Ordem de preferência do código: Resend > Gmail SMTP >
# ConsoleEmailSender. O console não envia nada — só imprime o link no terminal —
# e é o que entra em cena se nada aqui estiver preenchido, avisando por console.warn.
#
# Resend precisa dos DOIS: a chave e o remetente. O remetente tem que estar num
# domínio verificado na conta, senão a API recusa com 422 na hora de enviar.
RESEND_API_KEY=
RESEND_FROM=
#
# Alternativa: Gmail SMTP via Nodemailer, também precisa dos dois.
# GMAIL_APP_PASSWORD é uma senha de app da conta Google, não a senha normal.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# E-mail que recebe alertas de estoque mínimo e notificação de ticket
ADMIN_ALERT_EMAIL=
REP_ALERT_EMAIL=

# Fila de tarefas e cache de consulta de placa
REDIS_URL=redis://localhost:6379

# Observabilidade
NEW_RELIC_LICENSE_KEY=

# CI / Qualidade
SONAR_TOKEN=

# Estoque
STOCK_MIN_DEFAULT=5
