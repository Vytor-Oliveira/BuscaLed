# Banco de dados
DATABASE_URL=postgresql://buscaled:buscaled_dev@localhost:5432/buscaled

# Autenticação
JWT_SECRET=troque-por-uma-chave-secreta-forte
JWT_REFRESH_SECRET=troque-por-outra-chave-secreta-forte
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET não é usado no fluxo atual (verificação de ID token),
# só seria necessário para um fluxo de authorization code no servidor.
GOOGLE_CLIENT_SECRET=

# URL base da aplicação — usada para montar o link de confirmação de e-mail
APP_BASE_URL=http://localhost:3000

# Origem do frontend — usada pelo CORS para liberar cookies de sessão
FRONTEND_URL=http://localhost:5173

# PuxaPlaca (ex-apiplacas.com.br) — https://api.puxaplaca.app
APIPLACAS_TOKEN=

# E-mail transacional — Nodemailer via Gmail SMTP. Sem os dois preenchidos,
# cai no ConsoleEmailSender (só loga). GMAIL_APP_PASSWORD é uma senha de app
# da conta Google, não a senha normal.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDGRID_API_KEY=

# E-mail que recebe alertas de estoque mínimo e notificação de ticket
ADMIN_ALERT_EMAIL=
REP_ALERT_EMAIL=

# Fila de tarefas
REDIS_URL=redis://localhost:6379

# Observabilidade
NEW_RELIC_LICENSE_KEY=

# CI / Qualidade
SONAR_TOKEN=

# Estoque
STOCK_MIN_DEFAULT=5
