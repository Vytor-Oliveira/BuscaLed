generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENTE
  VENDEDOR
}

enum HeadlightPosition {
  BAIXO
  ALTO
  MILHA
  PISCA
  DRL
}

enum ReservationStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         UserRole @default(CLIENTE)
  createdAt    DateTime @default(now())

  reservations Reservation[]
}

// Modelo de veículo é resolvido em tempo de requisição (via API de placas) e
// nunca persistido — Privacy by Design. Apenas os dados derivados abaixo,
// necessários para a compatibilidade e o ticket, são gravados.
model VehicleModel {
  id           String   @id @default(uuid())
  make         String
  model        String
  yearStart    Int
  yearEnd      Int

  compatibilities LedCompatibility[]

  @@unique([make, model, yearStart, yearEnd])
}

model LedModel {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  stockQty    Int      @default(0)
  stockMin    Int      @default(5)

  compatibilities LedCompatibility[]
  reservationItems ReservationItem[]
}

model LedCompatibility {
  id             String            @id @default(uuid())
  vehicleModelId String
  ledModelId     String
  position       HeadlightPosition

  vehicleModel VehicleModel @relation(fields: [vehicleModelId], references: [id])
  ledModel     LedModel     @relation(fields: [ledModelId], references: [id])

  @@unique([vehicleModelId, ledModelId, position])
}

model Reservation {
  id        String            @id @default(uuid())
  userId    String
  status    ReservationStatus @default(PENDENTE)
  createdAt DateTime          @default(now())

  user  User               @relation(fields: [userId], references: [id])
  items ReservationItem[]
}

model ReservationItem {
  id            String @id @default(uuid())
  reservationId String
  ledModelId    String
  position      HeadlightPosition
  quantity      Int    @default(1)

  reservation Reservation @relation(fields: [reservationId], references: [id])
  ledModel    LedModel    @relation(fields: [ledModelId], references: [id])
}
