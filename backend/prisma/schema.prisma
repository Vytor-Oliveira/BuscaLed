generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  REP
  ADMIN
}

// 13 posições de luz do veículo, mapeando 1:1 as colunas da planilha real
// de compatibilidade da Shocklight (não é só "farol" — inclui pisca, freio,
// ré, teto e placa também).
enum LightingPosition {
  FAROL_BAIXO
  FAROL_ALTO
  NEBLINA
  LANTERNA_DIANTEIRA
  PISCA_DIANTEIRO
  PISCA_LATERAL
  LANTERNA_TRASEIRA
  PISCA_TRASEIRO
  LUZ_FREIO
  RE
  TETO
  PLACA
  DRL
}

enum ReservationStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  passwordHash               String?
  googleId                   String?   @unique
  role                       UserRole  @default(USER)
  emailVerifiedAt            DateTime?
  emailConfirmationToken     String?
  emailConfirmationExpiresAt DateTime?
  createdAt                  DateTime  @default(now())

  reservations   Reservation[]
  garageVehicles GarageVehicle[]
}

// Modelo de veículo é resolvido em tempo de requisição (via API de placas) e
// nunca persistido — Privacy by Design. Apenas os dados derivados abaixo,
// necessários para a compatibilidade e o ticket, são gravados.
model VehicleModel {
  id        String @id @default(uuid())
  make      String
  model     String
  yearStart Int
  yearEnd   Int

  fittings VehicleFitting[]

  @@unique([make, model, yearStart, yearEnd])
}

// Veículo → tipo de soquete por posição (dado importado da planilha da
// Shocklight, M3). Um veículo pode ter mais de um soquete válido na mesma
// posição (células compostas na planilha, ex: "H1 / HB3"), por isso o
// socketCode entra na chave única, não só a posição.
model VehicleFitting {
  id             String           @id @default(uuid())
  vehicleModelId String
  position       LightingPosition
  socketCode     String

  vehicleModel VehicleModel @relation(fields: [vehicleModelId], references: [id])

  @@unique([vehicleModelId, position, socketCode])
  @@index([socketCode])
}

// Garagem Virtual (RF03) — veículos salvos pelo próprio usuário. A placa
// usada para resolver make/model/year (via PlateService) nunca é gravada
// aqui nem em nenhum outro lugar — Privacy by Design (RF05/RN02).
model GarageVehicle {
  id        String   @id @default(uuid())
  userId    String
  make      String
  model     String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model LedModel {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  description String?
  socketCode  String
  stockQty    Int     @default(0)
  stockMin    Int     @default(5)

  reservationItems ReservationItem[]

  @@index([socketCode])
}

model Reservation {
  id        String            @id @default(uuid())
  userId    String
  status    ReservationStatus @default(PENDENTE)
  createdAt DateTime          @default(now())

  user  User               @relation(fields: [userId], references: [id])
  items ReservationItem[]
}

model ReservationItem {
  id            String @id @default(uuid())
  reservationId String
  ledModelId    String
  position      LightingPosition
  quantity      Int    @default(1)

  reservation Reservation @relation(fields: [reservationId], references: [id])
  ledModel    LedModel    @relation(fields: [ledModelId], references: [id])
}
