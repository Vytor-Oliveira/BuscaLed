# URL base da API do backend.
VITE_API_URL=http://localhost:3000

# Client ID do Google Identity Services. Opcional: sem ele o botão
# "Continuar com Google" simplesmente não é renderizado, em vez de aparecer
# quebrado. O login social exige HTTPS, então em dev sobre HTTP o próprio
# Google recusa o domínio.
# VITE_GOOGLE_CLIENT_ID=
