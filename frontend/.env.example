# URL base da API do backend.
VITE_API_URL=http://localhost:3000

# Porta do servidor de dev e alvo do proxy. Só precisam ser definidos para
# rodar fora do padrão do projeto — dois backends ao mesmo tempo, por exemplo.
# Apontar VITE_API_URL para o próprio servidor de dev faz as chamadas saírem
# same-origin, pelo proxy, sem CORS.
# VITE_PORT=5173
# VITE_PROXY_TARGET=http://localhost:3000

# Client ID do Google Identity Services. Opcional: sem ele o botão
# "Continuar com Google" simplesmente não é renderizado, em vez de aparecer
# quebrado. O login social exige HTTPS, então em dev sobre HTTP o próprio
# Google recusa o domínio.
# VITE_GOOGLE_CLIENT_ID=
